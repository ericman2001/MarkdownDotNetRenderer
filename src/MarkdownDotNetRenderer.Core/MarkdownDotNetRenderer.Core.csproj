<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MarkdownDotNetRenderer</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- DOCX only (Writers/Docx*). Reflection-based, so it is not trim/AOT-annotated; see
         docs/06-aot-and-dependencies.md for the containment rules. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the assembly; read at startup, never from disk or the network at runtime. -->
    <EmbeddedResource Include="Writers\default.css"
                      LogicalName="MarkdownDotNetRenderer.Writers.default.css" />
  </ItemGroup>

</Project>
