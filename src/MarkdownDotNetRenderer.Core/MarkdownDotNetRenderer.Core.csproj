<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MarkdownDotNetRenderer</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the assembly; read at startup, never from disk or the network at runtime. -->
    <EmbeddedResource Include="Writers\default.css"
                      LogicalName="MarkdownDotNetRenderer.Writers.default.css" />
  </ItemGroup>

</Project>
